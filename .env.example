# Copy to server/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://stockpilot:stockpilot@localhost:5433/stockpilot
DB_POOL_SIZE=10
# The origin the browser app is served from (Vite dev server in development).
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Used once on startup to create the first ADMIN when the users table is empty.
ADMIN_EMAIL=admin@stockpilot.local
ADMIN_PASSWORD=change-me-please-123
